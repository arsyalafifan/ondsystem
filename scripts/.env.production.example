# OND System - Production Environment (.env)
# Copy ke .env dan sesuaikan nilai-nilainya

APP_NAME="OND System"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATED_BY_SETUP_SCRIPT
APP_URL=https://ondsystem.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ond_database
DB_USERNAME=ond_app
DB_PASSWORD=SECURE_PASSWORD_HERE
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Redis (Cache, Session, Queue)
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
BROADCAST_DRIVER=log

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=log
# Untuk SMTP:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ondsystem.com
MAIL_FROM_NAME="OND System"

# Application Settings
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Trusted Proxies (untuk reverse proxy/load balancer)
TRUSTED_PROXIES=127.0.0.1,::1

# ========================================
# OND System Specific Settings
# ========================================

# ROUTING ENGINE
ROUTING_MAX_TOKO=25           # Max toko per kendaraan
ROUTING_MAX_DUS=220           # Max dus (weight) per kendaraan
ROUTING_MIN_DUS_PER_TOKO=5    # Minimal dus per pesanan

# DEPOT (Warehouse Location)
DEPOT_LAT=-6.175              # Jakarta default
DEPOT_LNG=106.827
DEPOT_NAMA="Depot Jakarta"
DEPOT_SERVICE_MINUTES=5       # Service time per toko (for ETA calculation)
DEPOT_JAM_BERANGKAT="08:00"   # Default departure time

# OSRM (Open Source Routing Machine)
# Rekomendasi produksi: self-hosted lewat Docker (scripts/setup-osrm.sh)
# sebagai utama, server publik sebagai cadangan otomatis kalau utama down.
OSRM_ENABLED=true
OSRM_URL=http://127.0.0.1:5000
OSRM_FALLBACK_URL=https://router.project-osrm.org
# Kalau belum sempat setup Docker OSRM, pakai publik saja sebagai utama:
# OSRM_URL=https://router.project-osrm.org
# OSRM_FALLBACK_URL=

# NOMINATIM (Geocoding Service)
NOMINATIM_EMAIL=admin@ondsystem.com

# VISIT SALES Settings
VISIT_MAKS_TOKO_PER_SALES=120      # Max toko per sales (target & limit)
VISIT_JARAK_WAJAR_M=300            # Reasonable distance (GPS tolerance)
VISIT_FOTO_LEBAR_MAKS=1280         # Photo resize width
VISIT_MODE_UJI=false               # Test mode (untuk development)

# ========================================
# Security & Performance
# ========================================

SESSION_LIFETIME=1440              # Session lifetime in minutes (24 hours)
SANCTUM_STATEFUL_DOMAINS=ondsystem.com

# Maintenance Mode
APP_MAINTENANCE_MODE=false

# ========================================
# Sentry (Error Tracking - Optional)
# ========================================
# SENTRY_LARAVEL_DSN=https://xxx@sentry.io/xxx

# ========================================
# AWS S3 (Optional, for file storage)
# ========================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=ondsystem
# AWS_USE_PATH_STYLE_ENDPOINT=false

# Filesystem
FILESYSTEM_DISK=local
FILESYSTEM_VISIBILITY=public
