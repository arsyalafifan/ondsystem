APP_NAME="OND System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ondsystem
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Peta & routing ---
# Server OSRM publik punya batas laju pemakaian. Untuk volume harian yang
# tinggi, jalankan OSRM sendiri lewat Docker (scripts/setup-osrm.sh), pasang
# di OSRM_URL, lalu isi OSRM_FALLBACK_URL dengan server publik sebagai
# cadangan kalau server sendiri down.
OSRM_URL=https://router.project-osrm.org
OSRM_FALLBACK_URL=
OSRM_ENABLED=true

# Nominatim mewajibkan alamat surel yang bisa dihubungi.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_EMAIL=
GEOCODE_COUNTRY=id

# --- Aturan bisnis ---
ROUTING_MAX_TOKO=25
ROUTING_MAX_DUS=220
ROUTING_MIN_DUS_PER_TOKO=5

# --- Gudang: titik awal dan akhir setiap rute ---
DEPOT_NAMA="Gudang Pusat"
DEPOT_LAT=-6.200000
DEPOT_LNG=106.816666
DEPOT_SERVICE_MINUTES=10
DEPOT_JAM_BERANGKAT=08:00

# --- Kunjungan sales ---
VISIT_MAKS_TOKO_PER_SALES=120
VISIT_JARAK_WAJAR_M=300
# Jalan pintas menguji alur kunjungan tanpa kamera (hanya saat APP_ENV=local).
VISIT_MODE_UJI=false

# Proksi yang boleh dipercaya headernya (cloudflared, nginx, load balancer).
# Tanpa ini, aplikasi di belakang HTTPS akan memuat aset http:// dan diblokir
# peramban. Bawaannya mesin ini sendiri; isi '*' hanya bila alamat proksinya
# memang tidak bisa dipastikan.
TRUSTED_PROXIES=127.0.0.1,::1
